# Copy this file to .env and fill in real values. Never commit the real .env file.

# Port the Express server listens on
PORT=5000

# MongoDB connection string (MongoDB Atlas or local). Do NOT commit real credentials.
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster-url>
DATABASE_NAME=smartPost

# bcrypt salt rounds for password hashing
BCRYPT_GEN_SALT_NUMBER=10

# Secret used to sign/verify JWTs — use a long, random, unique value in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET_KEY=replace-with-a-long-random-secret

# Cookie settings
COOKIE_EXPIRES=5d
COOKIE_KEY=smartPost

# Directory (relative to server/) where uploaded files are stored
UPLOAD_DIRECTORY=uploads

# Auth0 tenant domain (only needed if using the Auth0 login flow)
AUTH0_DOMAIN=your-tenant.us.auth0.com

# --- Password reset emails (optional) ---
# If these are left unset, "forgot password" still works end-to-end, but instead of
# emailing the reset link it gets printed to this server's console — fine for local dev,
# not fine for real users. Fill these in with real SMTP credentials to actually send email.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-smtp-username
EMAIL_PASS=your-smtp-password
EMAIL_FROM=noreply@yourdomain.com

# Base URL of the deployed frontend, used to build the password-reset link
CLIENT_ORIGIN=http://localhost:5173
