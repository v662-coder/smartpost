# Copy this file to .env and fill in real values. Never commit the real .env file.
#
# IMPORTANT: everything prefixed VITE_ is bundled into the public JS shipped to every
# browser. Never put a client secret, API key, or password in a VITE_ variable.

# Base URL of the backend API
VITE_SERVER_ENDPOINT=http://localhost:5000/api

# Key used to store the auth token in cookies
VITE_TOKEN_KEY=smartpost_token

# Key used to store the user role in cookies
VITE_USER_ROLE=role

# Cookie expiry, in days
VITE_COOKIE_EXPIRES=1

# Auth0 tenant domain + SPA client ID (public values — safe to expose to the browser).
# Do NOT put an Auth0 Client *Secret* here; SPAs never need it.
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-auth0-spa-client-id
